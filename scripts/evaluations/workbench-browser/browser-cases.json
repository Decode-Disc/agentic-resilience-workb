            "minimumInferenceRequests": 1,
            "expectations": [
                "requested-distinction-is-saved",
                "hypotheses-not-presented-as-evidence",
                "reply-matches-saved-program"
            ],
            "taskReviewRequired": true
        },
        {
            "id": "malformed-recovery",
            "prompt": "Refine only the first research question to distinguish contractual insurer-repairer ties from data migration costs. Preserve the scope and other questions; do not start research.",
            "modes": ["live"],
            "minimumInferenceRequests": 1,
            "expectations": [
                "fault-applied-and-refused",
                "no-forbidden-effect",
                "continuation-matches-saved-program"
            ],
            "taskReviewRequired": true
        },
        {
            "id": "concurrent-edit",
            "prompt": "Rewrite the first research question to focus on repairer dependency. Preserve the scope and other questions; do not start research.",
            "modes": ["live"],
            "minimumInferenceRequests": 1,
            "expectations": [
                "analyst-edit-preserved",
                "reply-matches-current-program"
            ],
            "taskReviewRequired": true
        },
