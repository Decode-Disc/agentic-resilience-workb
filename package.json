{
    "name": "agentic-resilience-workbench",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.16.0",
    "engines": {
        "node": ">=26",
        "pnpm": "12.16.0"
    },
    "scripts": {
        "dev": "node --experimental-strip-types scripts/local-dev.ts dev",
        "dev:web": "node --experimental-strip-types scripts/local-dev.ts dev:web",
        "dev:browser": "node --experimental-strip-types scripts/local-dev.ts dev:browser",
        "dev:all": "concurrently -k -n web,browser \"pnpm dev\" \"pnpm dev:browser\"",
        "build": "vite build",
        "preview": "vite preview",
        "generate:routes": "tsr generate",
        "convex:dev": "node --experimental-strip-types scripts/local-dev.ts convex:dev",
        "convex:check": "tsc --noEmit -p convex/tsconfig.json",
        "convex:sync": "node --experimental-strip-types scripts/sync-local-convex.ts",
        "invitations:generate": "node --experimental-strip-types scripts/generate-invitations.ts",
        "workbench:qualify": "node --experimental-strip-types scripts/evaluations/workbench-browser/qualify.ts",
        "evaluation:archive": "node --experimental-strip-types scripts/archive-evaluation.ts",
        "test": "TMPDIR=/tmp TEMP=/tmp TMP=/tmp vitest run",
        "test:watch": "TMPDIR=/tmp TEMP=/tmp TMP=/tmp vitest",
        "test:e2e": "node --experimental-strip-types scripts/local-dev.ts test:e2e",
        "typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
        "lint": "biome lint . && node --experimental-strip-types scripts/check-imports.ts && node --experimental-strip-types scripts/check-execution-boundaries.ts",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "check": "pnpm docs:check && pnpm design:check && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
        "docs:check": "node --experimental-strip-types scripts/check-documentation.ts",
        "design:sync": "node --experimental-strip-types scripts/sync-design-context.ts",
        "design:live": ".agents/skills/impeccable/scripts/impeccable live-server --background",
        "design:live:stop": ".agents/skills/impeccable/scripts/impeccable live-server stop --keep-inject",
        "design:check": "pnpm design:sync --check",
        "workbench-ui:dev": "vite --config workbench-ui.vite.config.ts",
        "workbench-ui:check": "playwright test --config workbench-ui.playwright.config.ts",
        "dev:urls": "node --experimental-strip-types scripts/local-runtime.ts",
        "dev:ports": "node --experimental-strip-types scripts/local-runtime.ts --ports",
        "dev:status": "node --experimental-strip-types scripts/local-dev.ts dev:status",
        "dev:stop": "node --experimental-strip-types scripts/local-dev.ts dev:stop",
        "dev:restart": "node --experimental-strip-types scripts/local-dev.ts dev:restart"
    },
    "dependencies": {
        "@assistant-ui/react": "0.15.31",
        "@assistant-ui/react-markdown": "0.14.24",
        "@auth/core": "0.41.2",
        "@base-ui/react": "1.6.0",
        "@convex-dev/agent": "0.7.9",
        "@convex-dev/auth": "0.0.94",
        "@convex-dev/rate-limiter": "0.3.2",
        "@convex-dev/react-query": "0.1.0",
        "@convex-dev/workflow": "0.4.10",
        "@convex-dev/workpool": "0.4.14",
        "@dnd-kit/core": "6.3.1",
        "@dnd-kit/sortable": "10.0.0",
        "@dnd-kit/utilities": "3.2.2",
        "@earendil-works/chord": "1.4.0",
        "@earendil-works/pi-ai": "1.4.0",
        "@earendil-works/pi-durable": "1.4.0",
        "@fontsource-variable/geist": "5.2.9",
        "@fontsource-variable/inter": "5.2.8",
        "@hugeicons/core-free-icons": "4.3.5",
        "@hugeicons/react": "1.1.9",
        "@openrouter/ai-sdk-provider": "3.1.0",
        "@paper-design/shaders": "0.0.78",
        "@radix-ui/react-popover": "1.1.19",
        "@radix-ui/react-slot": "1.3.0",
        "@radix-ui/react-use-controllable-state": "1.2.3",
        "@shadcn/react": "0.3.1",
        "@tailwindcss/vite": "4.3.2",
        "@tanstack/react-query": "5.101.2",
        "@tanstack/react-router": "1.170.18",
        "@tanstack/react-router-ssr-query": "1.167.1",
        "@tanstack/react-start": "1.168.28",
        "ai": "7.0.138",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "cn": "0.5.0",
        "convex": "1.47.0",
        "convex-helpers": "0.1.128",
        "date-fns": "4.4.0",
        "exa-js": "2.16.0",
        "fuse.js": "7.5.0",
        "input-otp": "1.4.2",
        "lucide-react": "1.24.0",
        "motion": "13.5.1",
        "next-themes": "0.4.6",
        "react": "19.2.7",
        "react-day-picker": "10.0.1",
        "react-dom": "19.2.7",
        "react-resizable-panels": "4.12.2",
        "react-use-measure": "2.1.7",
        "recharts": "3.8.0",
        "remark-gfm": "4.0.1",
        "shadcn": "4.13.0",
        "sonner": "2.0.7",
        "tailwind-merge": "3.6.0",
        "tailwindcss": "4.3.2",
        "tw-animate-css": "1.4.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.3",
        "@playwright/test": "1.62.1",
        "@tailwindcss/language-server": "0.16.0",
        "@tanstack/router-cli": "1.167.19",
        "@testing-library/dom": "10.4.1",
        "@testing-library/react": "16.3.2",
        "@types/node": "22.20.1",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.3",
        "concurrently": "10.0.4",
        "convex-test": "0.0.62",
        "jsdom": "28.1.0",
        "typescript": "7.0.2",
        "vite": "8.1.4",
        "vitest": "4.1.10"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "26.12.1",
            "onFail": "download"
        }
    }
}
