{
    "name": "agentic-resilience-evidence-workbench",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.20.0",
    "engines": {
        "node": ">=22.12.0 <25",
        "pnpm": "10.20.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "lightningcss"
        ]
    },
    "scripts": {
        "dev": "CONVEX_TMPDIR=/tmp convex dev --start 'vite dev --port 3000'",
        "dev:web": "vite dev --port 3000",
        "build": "vite build",
        "preview": "vite preview",
        "generate:routes": "tsr generate",
        "convex:dev": "CONVEX_TMPDIR=/tmp convex dev",
        "convex:check": "CONVEX_TMPDIR=/tmp convex dev --once",
        "invitations:generate": "node --experimental-strip-types scripts/generate-invitations.ts",
        "test": "TMPDIR=/tmp TEMP=/tmp TMP=/tmp vitest run",
        "test:watch": "TMPDIR=/tmp TEMP=/tmp TMP=/tmp vitest",
        "typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
        "lint": "biome lint . && node --experimental-strip-types scripts/check-imports.ts",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
    },
    "dependencies": {
        "@auth/core": "0.41.2",
        "@base-ui/react": "1.6.0",
        "@convex-dev/auth": "0.0.94",
        "@convex-dev/react-query": "0.1.0",
        "@convex-dev/workflow": "0.4.4",
        "@convex-dev/workpool": "0.4.8",
        "@fontsource-variable/geist": "5.2.9",
        "@fontsource-variable/inter": "5.2.8",
        "@hugeicons/core-free-icons": "4.2.2",
        "@hugeicons/react": "1.1.9",
        "@radix-ui/react-popover": "1.1.19",
        "@radix-ui/react-slot": "1.3.0",
        "@radix-ui/react-use-controllable-state": "1.2.3",
        "@tailwindcss/vite": "4.3.2",
        "@tanstack/react-query": "5.101.2",
        "@tanstack/react-router": "1.170.18",
        "@tanstack/react-router-ssr-query": "1.167.1",
        "@tanstack/react-start": "1.168.28",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "convex": "1.42.1",
        "convex-helpers": "0.1.120",
        "date-fns": "4.4.0",
        "exa-js": "2.16.0",
        "input-otp": "1.4.2",
        "lucide-react": "1.24.0",
        "motion": "12.42.2",
        "next-themes": "0.4.6",
        "react": "19.2.7",
        "react-day-picker": "10.0.1",
        "react-dom": "19.2.7",
        "react-resizable-panels": "4.12.2",
        "react-use-measure": "2.1.7",
        "recharts": "3.8.0",
        "shadcn": "4.13.0",
        "sonner": "2.0.7",
        "tailwind-merge": "3.6.0",
        "tailwindcss": "4.3.2",
        "tw-animate-css": "1.4.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.3",
        "@tanstack/router-cli": "1.167.19",
        "@testing-library/dom": "10.4.1",
        "@testing-library/react": "16.3.2",
        "@types/node": "22.20.1",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.3",
        "convex-test": "0.0.54",
        "jsdom": "28.1.0",
        "typescript": "6.0.3",
        "typescript-7": "npm:typescript@rc",
        "vite": "8.1.4",
        "vitest": "4.1.10"
    }
}
