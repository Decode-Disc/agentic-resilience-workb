{
    "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "src/**",
            "convex/**",
            "scripts/**",
            "!scripts/evaluations/source-selection/runs",
            "!scripts/evaluations/source-selection/fixtures",
            "*.ts",
            "*.json",
            "!src/routeTree.gen.ts",
            "!convex/_generated",
            "!docs/*",
            "!src/__tests__/design-system/workbench-ui/references"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 80
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "correctness": {
                "recommended": true,
                "useExhaustiveDependencies": "warn",
                "useHookAtTopLevel": "error"
            },
            "suspicious": {
                "recommended": true,
                "noExplicitAny": "error",
                "noArrayIndexKey": "error"
            },
            "style": {
                "recommended": true,
                "useConst": "error",
                "useImportType": "error",
                "useExportType": "error",
                "useNamingConvention": "off"
            },
            "a11y": {
                "recommended": true,
                "useButtonType": "error",
                "useAnchorContent": "error"
            },
            "performance": {
                "noAccumulatingSpread": "error"
            }
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "jsxQuoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "all",
            "arrowParentheses": "always",
            "bracketSpacing": true,
            "bracketSameLine": true
        }
    },
    "json": {
        "formatter": {
            "trailingCommas": "none"
        }
    },
    "overrides": [
        {
            "includes": ["**/*", "!src/__tests__/**"],
            "plugins": ["./tools/biome/no-chained-type-assertions-error.grit"]
        },
        {
            "includes": ["src/__tests__/**"],
            "plugins": ["./tools/biome/no-chained-type-assertions.grit"]
        },
        {
            "includes": ["src/**/*.{js,jsx,ts,tsx}"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "patterns": [
                                    {
                                        "group": ["../**"],
                                        "message": "Use the '@/...' or '@convex/...' alias instead of relative parent imports ('../...')."
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["convex/**/*.{js,jsx,ts,tsx}"],
            "linter": {
                "rules": {
                    "style": {
                        "noRestrictedImports": {
                            "level": "error",
                            "options": {
                                "patterns": [
                                    {
                                        "group": ["../**", "!../_generated/**"],
                                        "message": "Use '@convex/' alias."
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        },
        {
            "includes": ["src/__tests__/**/*.{ts,tsx}"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noExplicitAny": "off"
                    },
                    "style": {
                        "noRestrictedImports": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "src/components/ui/**/*.{ts,tsx}",
                "src/components/chat/agent-question.tsx",
                "src/components/chat/message.tsx"
            ],
            "linter": {
                "rules": {
                    "correctness": {
                        "useExhaustiveDependencies": "off"
                    },
                    "a11y": {
                        "useSemanticElements": "off",
                        "useKeyWithClickEvents": "off",
                        "useFocusableInteractive": "off",
                        "useAriaPropsForRole": "off",
                        "noLabelWithoutControl": "off",
                        "noSvgWithoutTitle": "off"
                    }
                }
            }
        }
    ]
}
