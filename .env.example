# Convex deployment name written by the development watcher.
CONVEX_DEPLOYMENT=

# Public Convex URL consumed by the TanStack Start client.
VITE_CONVEX_URL=http://127.0.0.1:3210

# Local HTTP actions URL written by Convex. Reserved for later server integrations.
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# Server-only values. Generate the unique four-digit OTPs with
# `pnpm invitations:generate`, then set them on each Convex deployment; never
# expose them through VITE_ variables.
INVITATION_CODE_PEPPER=
INVITATION_SEED_CONFIG=

# Set temporarily only when rotating a lost admin invitation through the
# internal `invitations:rotateAdminFromConfig` action, then remove it.
INVITATION_ADMIN_RECOVERY_CODE=

# External discovery configuration. SEC requires an identifying user agent.
# Exa is paid and remains optional; discovery falls back to SEC metadata when
# no key is configured.
SEC_USER_AGENT=Agentic Resilience Workbench contact@example.com
EXA_API_KEY=

# Resource defaults have one authored owner: convex/resourcePolicy.ts.
# Overrides affect newly admitted work, not existing grants or consumption.
# Server-only preparation settings must also be set on the intended Convex
# deployment. Enabling preparation does not start existing draft dossiers.
OPENROUTER_API_KEY=
SOURCE_QUALIFICATION_ENABLED=false
# Cumulative productive and technical-incident allowances, snapshotted at explicit execution start.
SOURCE_PREPARATION_WORK_LIMIT=120
SOURCE_PREPARATION_INCIDENT_LIMIT=40
# Shared reading/comparison concurrency per dossier, snapshotted at execution start or explicit recovery.
# Positive safe integer; independent of the global Workflow queue capacity.
SOURCE_PREPARATION_MAX_CONCURRENCY=2
# Structured lexical retrieval requires no embedding provider credentials.
SOURCE_RETRIEVAL_MODE=lexical
# Optional hosted embeddings for hybrid retrieval (SOURCE_RETRIEVAL_MODE=hybrid).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_TOKEN=

# Live agents. Both are paid, unqualified for general use and off by default.
# WORKBENCH_AGENT_ENABLED lets the Workbench conversation call its assigned model.
WORKBENCH_AGENT_ENABLED=false
# Research starts only through the Sources mission. Without both values below,
# Start is refused with an explanation; there is no other preparation path.
SOURCES_MISSION_ENABLED=false
# Version-one envelope, pinned on each dossier at Start. maxNeeds counts one
# common-context need plus one per framed question, so it must be at least the
# program's question count + 1 (up to 12 for the 11-question framing limit);
# Start refuses larger programs. Each value is an integer from 1 to 160, and
# acquisitions is at most 60 (convex/resourcePolicy.ts). The example equals
# SOURCES_QUALIFICATION_ENVELOPE in convex/runWorkspace.ts.
SOURCES_MISSION_ENVELOPE={"version":1,"maxNeeds":4,"initialSearches":2,"complementSearches":1,"acquisitions":6,"controls":8}

# Bounded collection scopes. Company search returns one ranked set that the UI
# pages locally; source discovery stops before the dossier reaches its review
# limit. Keep both values explicit on every Convex deployment.
COMPANY_SEARCH_RESULT_LIMIT=40
SOURCE_CANDIDATE_LIMIT=48
# Optional override. Defaults to ceil(SOURCE_CANDIDATE_LIMIT / 2).
# SOURCE_RECOMMENDATION_CEILING=24
# Optional SEC request timeout override in milliseconds; defaults to
# DEFAULT_SEC_TIMEOUT_MS in convex/resourcePolicy.ts.
# SEC_TIMEOUT_MS=10000

# Optional browser preview service (services/playwright-browser) for visual
# previews and company covers. Without it, previews are reported unavailable.
# PREVIEW_SERVICE_URL=http://127.0.0.1:3100
# PREVIEW_SERVICE_SECRET=
# Preview cache lifetime in milliseconds (minimum 1000; default one hour).
# PREVIEW_CACHE_TTL_MS=3600000

# Local qualification reviewer only, not Convex deployment settings.
# Configure privately in the Git main worktree .env.local; process overrides win.
# API key selects OpenAI API for new mandates. Leave unset to use Pi-stored API credentials or Codex OAuth.
# An empty API key is an error, not permission to fall back. Do not copy keys across worktrees.
# OPENAI_API_KEY=
# Native context/compaction use Pi. The mandate owns the absolute analysis deadline.
WORKBENCH_REVIEW_REASONING=high

# Explicit opt-in for bounded provider contract tests. Keep disabled in
# default and CI test runs.
RUN_LIVE_PROVIDER_TESTS=0

# Second opt-in required by the reusable Exa Contents vs Firecrawl Scrape
# benchmark. It has no effect unless live provider tests are also enabled.
RUN_RETRIEVAL_BENCHMARK=0

# Second opt-in for the no-persistence source-selection benchmark.
RUN_SOURCE_SELECTION_BENCHMARK=0
