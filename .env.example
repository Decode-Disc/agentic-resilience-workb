# Convex deployment name written by `pnpm convex:check`.
CONVEX_DEPLOYMENT=

# Public Convex URL consumed by the TanStack Start client.
VITE_CONVEX_URL=http://127.0.0.1:3210

# Local HTTP actions URL written by Convex. Reserved for later server integrations.
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# Server-only values. Generate the unique four-digit OTPs with
# `pnpm invitations:generate`, then set them on each Convex deployment; never
# expose them through VITE_ variables.
INVITATION_CODE_PEPPER=
INVITATION_SEED_CONFIG=

# Set temporarily only when rotating a lost admin invitation through the
# internal `invitations:rotateAdminFromConfig` action, then remove it.
INVITATION_ADMIN_RECOVERY_CODE=

# External discovery configuration. SEC requires an identifying user agent.
# Exa is paid and remains optional; discovery falls back to SEC metadata when
# no key is configured.
SEC_USER_AGENT=Agentic Resilience Evidence Workbench contact@example.com
EXA_API_KEY=

# Bounded collection scopes. Company search returns one ranked set that the UI
# pages locally; source discovery stops before the dossier reaches its review
# limit. Keep both values explicit on every Convex deployment.
COMPANY_SEARCH_RESULT_LIMIT=40
SOURCE_CANDIDATE_LIMIT=48
# Optional override. Defaults to ceil(SOURCE_CANDIDATE_LIMIT / 2).
# SOURCE_RECOMMENDATION_CEILING=24

# Explicit opt-in for bounded provider contract tests. Keep disabled in
# default and CI test runs.
RUN_LIVE_PROVIDER_TESTS=0

# Second opt-in required by the reusable Exa Contents vs Firecrawl Scrape
# benchmark. It has no effect unless live provider tests are also enabled.
RUN_RETRIEVAL_BENCHMARK=0

# Second opt-in for the no-persistence source-selection benchmark.
RUN_SOURCE_SELECTION_BENCHMARK=0
